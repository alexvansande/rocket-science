{
  "game": "Triskelion",
  "description": "Rocket-science deckbuilder. Machine-readable card data with real specs and derivation.",
  "model": {
    "rocket_equation": "dv = ve * ln(total_mass / (dry_mass + cargo))",
    "exhaust_velocity": "ve = isp_s * 9.81 / 1000  (km/s)",
    "board_dot": "1 dot = 1 km/s of dv",
    "token_values_t": {
      "Y": 10,
      "O": 40,
      "R": 160,
      "K": 640
    },
    "mass_ladder_t": [
      10,
      20,
      30,
      40,
      80,
      120,
      160,
      320,
      480,
      640,
      1280,
      1920,
      2560
    ],
    "strip_derivation": "total_mass is fixed (snapped up the ladder). Each strip row splits total between fuel and cargo. dv computed by the rocket equation. Rows with fuel<=0 or dv rounding to 0 dropped; on a dv tie keep the larger cargo.",
    "ignition": {
      "earth": "ground-capable",
      "space": "vacuum only",
      "both": "ground and space",
      "mars-surface": "ignites from the Mars surface (low-gravity ascent)"
    },
    "notes": "Only isp_s is real/sacred. dry_mass is a tuning dial with a FLOOR (dry >= total/16, rounded up) and a CLEANLINESS target (total >= 320: refuel = total - dry lays out in <= 2 token colours). Exemption: Kerolox Booster (K2) dry 20 \u2014 the First Orbit knife-edge; tested at 30 and 40, both break it. total/fuel flex to fit the ladder. real_total_mass_t = historical mass, printed on the card beside the in-game rounding."
  },
